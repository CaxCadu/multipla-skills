{
  "name": "multipla-skills-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source library of AI skills delivered through an MCP server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "tsx scripts/validate-skills.ts",
    "check:links": "tsx scripts/check-links.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:validator": "tsx scripts/test-validator.ts",
    "check": "npm run typecheck && npm run validate && npm run check:links && npm run test:validator"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
