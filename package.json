{
  "name": "multipla-skills-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source library of AI skills delivered through an MCP server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "tsx scripts/validate-skills.ts",
    "check:links": "tsx scripts/check-links.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:validator": "tsx scripts/test-validator.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "check:registry": "tsx scripts/build-registry.ts --check",
    "test:registry": "tsx scripts/test-registry.ts",
    "typecheck:server": "npm run typecheck -w multipla-skills",
    "build:server": "npm run build -w multipla-skills",
    "test:server": "npm test -w multipla-skills",
    "check": "npm run typecheck && npm run typecheck:server && npm run validate && npm run check:links && npm run check:registry && npm run test:validator && npm run test:registry && npm run test:server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
