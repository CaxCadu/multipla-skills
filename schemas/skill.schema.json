{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CaxCadu/multipla-skills/schemas/skill.schema.json",
  "title": "Multipla skill metadata (skill.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "version", "summary", "language", "areas", "profiles", "tags",
    "region", "level", "risk", "requires_scripts", "sources", "last_researched",
    "authors", "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "areas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "region": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[A-Z]{2}$" }] },
    "level": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["starting", "experienced", "expert"] }
    },
    "risk": { "enum": ["low", "medium", "high"] },
    "requires_scripts": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessed"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "last_researched": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["draft", "reviewed", "stable"] },
    "conflicts_with": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}
