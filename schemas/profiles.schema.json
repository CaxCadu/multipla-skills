{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CaxCadu/multipla-skills/schemas/profiles.schema.json",
  "title": "Multipla profile registry (registry/profiles.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "areas", "profiles"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "areas", "starter_bundle"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "areas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "starter_bundle": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
